# Copiar como .env en esta carpeta (ignorado por git) y llenar los valores

# SQL SERVER
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_SA_PASSWORD=
MSSQL_PID=Developer
TZ=America/Mexico_City

# PORTS
PRIMARY_SQL_PORT=1443
SECONDARY_SQL_PORT=1444

# PRIMARY / SECONDARY NODE
PRIMARY_DATA_PATH=
SECONDARY_DATA_PATH=

# SHARED
BACKUP_PATH=
SCRIPTS_PATH=

# Contrasena para master key, logins entre nodos y AgAdmin.
# Los scripts procces/*.sql la usan como variable sqlcmd $(AG_PASSWORD)
AG_PASSWORD=
