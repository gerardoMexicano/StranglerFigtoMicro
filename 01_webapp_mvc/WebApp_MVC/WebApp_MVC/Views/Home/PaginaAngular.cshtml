@{
    ViewBag.Title = "Demo de Rendimiento: .NET Framework vs .NET 10";
    Layout = "~/Views/Shared/_LayoutProtected.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
    :root {
        --bg-dark: #0f172a;
        --card-bg: rgba(30, 41, 59, 0.8);
        --border-color: rgba(255, 255, 255, 0.1);
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        
        --color-netfw: #e11d48; /* Red for legacy */
        --color-net10: #10b981; /* Green for modern */
    }

    body {
        background-color: var(--bg-dark) !important;
        color: var(--text-main) !important;
    }

    .demo-header {
        text-align: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .glass-panel {
        background: var(--card-bg);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1.5rem;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .panel-title {
        font-weight: 700;
        text-align: center;
        margin-bottom: 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .metric-box {
        background: rgba(0, 0, 0, 0.2);
        border-radius: 8px;
        padding: 0.65rem;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .metric-label {
        font-size: 0.72rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.2rem;
    }

    .metric-value {
        font-size: 1.15rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .fw-value { color: var(--color-netfw); }
    .net10-value { color: var(--color-net10); }

    .map-container {
        position: relative;
        flex-grow: 1;
        min-height: 380px;
        background: #1e293b;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .leaflet-container {
        background: #0f172a !important;
    }

    .overlay-status {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 1rem;
        background: rgba(15, 23, 42, 0.85);
        font-weight: bold;
        font-size: 1.2rem;
        z-index: 10;
        transition: opacity 0.3s;
    }

    .btn-run {
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        color: white;
        border: none;
        padding: 10px 24px;
        font-size: 1.05rem;
        font-weight: 700;
        border-radius: 8px;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-run:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.4);
    }
    
    .btn-run:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
        box-shadow: none;
    }

    .memory-bar-container {
        height: 8px;
        background: rgba(255,255,255,0.1);
        border-radius: 4px;
        margin-top: 0.4rem;
        overflow: hidden;
    }

    .memory-bar {
        height: 100%;
        transition: width 0.3s ease;
    }

    .control-input {
        background: rgba(15, 23, 42, 0.9) !important;
        color: #f8fafc !important;
        border: 1px solid rgba(255, 255, 255, 0.2) !important;
    }
</style>

<div class="container-fluid mt-3" id="demo-app">
    <div class="demo-header">
        <h1 style="font-weight: 800; background: linear-gradient(to right, #fff, #94a3b8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
            Comparativa de Backends: .NET Framework 4.8 vs .NET 10
        </h1>
        <p style="color: var(--text-muted); font-size: 1.05rem; margin-bottom: 1rem;">
            Convivencia de implementaciones (Strangler Fig) — Procesamiento y validación de Sismos (GeoJSON)
        </p>

        <!-- Panel de control para seleccionar el backend y los parámetros de prueba -->
        <div class="glass-panel mb-3" style="padding: 1rem 1.25rem; text-align: left;">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="backendSelect" class="metric-label d-block">Backend a ejecutar</label>
                    <select id="backendSelect" class="form-select control-input">
                        <option value="both" selected>Ambos Backends (Comparativa Simultánea)</option>
                        <option value="legacy">Solo Backend Legado (.NET Framework 4.8)</option>
                        <option value="net10">Solo Backend Moderno (.NET 10 — /api/taxes/seismic-geojson)</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="inputCount" class="metric-label d-block">Cantidad (1 - 10,000)</label>
                    <input type="number" id="inputCount" class="form-control control-input" value="5000" step="500" />
                </div>
                <div class="col-md-2">
                    <label for="inputMinMag" class="metric-label d-block">Magnitud Mínima (0 - 10)</label>
                    <input type="number" id="inputMinMag" class="form-control control-input" value="1.0" step="0.5" />
                </div>
                <div class="col-md-2">
                    <label for="inputSeed" class="metric-label d-block">Semilla Determinista</label>
                    <input type="number" id="inputSeed" class="form-control control-input" value="2026" />
                </div>
                <div class="col-md-3 d-grid">
                    <button id="btnRun" class="btn-run">
                        Ejecutar Comparativa
                    </button>
                </div>
            </div>
            <div id="equivalenceBanner" class="mt-3 p-2 rounded text-center" style="display: none; font-size: 0.9rem; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #a7f3d0;">
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Panel .NET Framework 4.8 -->
        <div class="col-lg-6">
            <div class="glass-panel">
                <div class="panel-title" style="color: var(--color-netfw); font-size: 1.4rem;">
                    Backend Legado: .NET Framework 4.8 (MVC)
                </div>
                <div style="font-size: 0.82rem; color: var(--text-muted); text-align: center; margin-bottom: 0.85rem;">
                    Endpoint: <code>/taxes/Home/CompararSismos?backend=legacy</code> (IIS + Newtonsoft.Json)
                </div>

                <div class="metrics-grid">
                    <div class="metric-box">
                        <div class="metric-label">Tiempo HTTP / Servidor</div>
                        <div class="metric-value fw-value" id="fw-parse-time">-- ms</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-label">Estado HTTP &amp; Render</div>
                        <div class="metric-value fw-value" id="fw-render-time">--</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-label">Sismos / Mag. Promedio</div>
                        <div class="metric-value fw-value" id="fw-fps">--</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-label">Memoria Asignada</div>
                        <div class="metric-value fw-value" id="fw-memory">-- MB</div>
                        <div class="memory-bar-container">
                            <div class="memory-bar" style="width: 5%; background: var(--color-netfw);" id="fw-memory-bar"></div>
                        </div>
                    </div>
                </div>

                <div class="map-container" id="fw-container">
                    <div class="overlay-status" id="fw-overlay">Esperando ejecución...</div>
                    <div id="fw-map" style="width: 100%; height: 100%; position: absolute; top: 0; left: 0; z-index: 1;"></div>
                </div>
            </div>
        </div>

        <!-- Panel .NET 10 -->
        <div class="col-lg-6">
            <div class="glass-panel">
                <div class="panel-title" style="color: var(--color-net10); font-size: 1.4rem;">
                    Backend Moderno: .NET 10 (Clean Architecture)
                </div>
                <div style="font-size: 0.82rem; color: var(--text-muted); text-align: center; margin-bottom: 0.85rem;">
                    Endpoint: <code>/api/taxes/seismic-geojson</code> (Kestrel Docker + System.Text.Json + JWT)
                </div>

                <div class="metrics-grid">
                    <div class="metric-box">
                        <div class="metric-label">Tiempo HTTP / Servidor</div>
                        <div class="metric-value net10-value" id="net10-parse-time">-- ms</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-label">Estado HTTP &amp; Render</div>
                        <div class="metric-value net10-value" id="net10-render-time">--</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-label">Sismos / Mag. Promedio</div>
                        <div class="metric-value net10-value" id="net10-fps">--</div>
                    </div>
                    <div class="metric-box">
                        <div class="metric-label">Memoria Asignada</div>
                        <div class="metric-value net10-value" id="net10-memory">-- MB</div>
                        <div class="memory-bar-container">
                            <div class="memory-bar" style="width: 5%; background: var(--color-net10);" id="net10-memory-bar"></div>
                        </div>
                    </div>
                </div>

                <div class="map-container" id="net10-container">
                    <div class="overlay-status" id="net10-overlay">Esperando ejecución...</div>
                    <div id="net10-map" style="width: 100%; height: 100%; position: absolute; top: 0; left: 0; z-index: 1;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const endpointBaseUrl = '@Url.Action("CompararSismos", "Home")';

        const btnRun = document.getElementById('btnRun');
        const backendSelect = document.getElementById('backendSelect');
        const inputCount = document.getElementById('inputCount');
        const inputMinMag = document.getElementById('inputMinMag');
        const inputSeed = document.getElementById('inputSeed');
        const equivalenceBanner = document.getElementById('equivalenceBanner');

        // Framework 4.8 UI
        const fwOverlay = document.getElementById('fw-overlay');
        const fwParseLbl = document.getElementById('fw-parse-time');
        const fwRenderLbl = document.getElementById('fw-render-time');
        const fwStatsLbl = document.getElementById('fw-fps');
        const fwMemoryLbl = document.getElementById('fw-memory');
        const fwMemoryBar = document.getElementById('fw-memory-bar');

        // .NET 10 UI
        const net10Overlay = document.getElementById('net10-overlay');
        const net10ParseLbl = document.getElementById('net10-parse-time');
        const net10RenderLbl = document.getElementById('net10-render-time');
        const net10StatsLbl = document.getElementById('net10-fps');
        const net10MemoryLbl = document.getElementById('net10-memory');
        const net10MemoryBar = document.getElementById('net10-memory-bar');

        // Inicialización de mapas Leaflet con preferCanvas
        const fwMap = L.map('fw-map', { preferCanvas: true }).setView([23.6345, -102.5528], 5);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap &copy; CARTO'
        }).addTo(fwMap);
        const fwLayerGroup = L.layerGroup().addTo(fwMap);

        const net10Map = L.map('net10-map', { preferCanvas: true }).setView([23.6345, -102.5528], 5);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; OpenStreetMap &copy; CARTO'
        }).addTo(net10Map);
        const net10LayerGroup = L.layerGroup().addTo(net10Map);

        function showOverlay(overlayEl, text, isError) {
            overlayEl.style.display = 'flex';
            overlayEl.style.opacity = '1';
            overlayEl.style.color = isError ? '#fda4af' : '#f8fafc';
            overlayEl.innerText = text;
        }

        function hideOverlay(overlayEl) {
            overlayEl.style.opacity = '0';
            setTimeout(() => { overlayEl.style.display = 'none'; }, 250);
        }

        function renderPointsOnMap(layerGroup, points, color) {
            const startRender = performance.now();
            layerGroup.clearLayers();
            if (Array.isArray(points)) {
                for (let i = 0; i < points.length; i++) {
                    const q = points[i];
                    L.circleMarker([q.lat, q.lng], {
                        radius: 3,
                        fillColor: color,
                        color: color,
                        weight: 1,
                        opacity: 0.8,
                        fillOpacity: 0.6
                    }).addTo(layerGroup);
                }
            }
            return Math.round(performance.now() - startRender);
        }

        async function invokeBackend(targetBackend, count, minMag, seed, ui) {
            showOverlay(ui.overlay, 'Consultando backend (' + targetBackend + ')...', false);
            ui.parseLbl.innerText = '...';
            ui.renderLbl.innerText = '...';
            ui.statsLbl.innerText = '...';
            ui.memoryLbl.innerText = '...';

            const url = `${endpointBaseUrl}?backend=${encodeURIComponent(targetBackend)}&count=${encodeURIComponent(count)}&minMagnitude=${encodeURIComponent(minMag)}&seed=${encodeURIComponent(seed)}`;
            const startHttp = performance.now();

            try {
                const response = await fetch(url, {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' },
                    credentials: 'same-origin'
                });
                const httpElapsed = Math.round(performance.now() - startHttp);
                const payload = await response.json();

                if (!response.ok) {
                    const detail = payload.detail || payload.title || 'Error en la petición';
                    ui.parseLbl.innerText = `${httpElapsed} ms`;
                    ui.renderLbl.innerText = `HTTP ${response.status}`;
                    ui.statsLbl.innerText = 'Validación';
                    ui.memoryLbl.innerText = '0 MB';
                    ui.memoryBar.style.width = '0%';
                    ui.layerGroup.clearLayers();
                    showOverlay(ui.overlay, `HTTP ${response.status}: ${detail}`, true);
                    return { ok: false, status: response.status, detail: detail, httpElapsed: httpElapsed };
                }

                const renderMs = renderPointsOnMap(ui.layerGroup, payload.points, ui.color);
                ui.parseLbl.innerText = `${httpElapsed} ms (Srv: ${payload.serverElapsedMs} ms)`;
                ui.renderLbl.innerText = `HTTP ${response.status} (${renderMs} ms)`;
                ui.statsLbl.innerText = `${payload.returnedCount} pts (Ø ${payload.averageMagnitude})`;
                ui.memoryLbl.innerText = `${payload.memoryMegabytes} MB`;
                const barPct = Math.min(100, Math.max(5, Math.round(payload.memoryMegabytes * 20)));
                ui.memoryBar.style.width = `${barPct}%`;
                hideOverlay(ui.overlay);

                return { ok: true, status: response.status, data: payload, httpElapsed: httpElapsed };
            } catch (err) {
                ui.renderLbl.innerText = 'Error de red';
                showOverlay(ui.overlay, 'No se pudo conectar con el servidor.', true);
                return { ok: false, status: 0, detail: err.message };
            }
        }

        btnRun.addEventListener('click', async () => {
            btnRun.disabled = true;
            equivalenceBanner.style.display = 'none';

            const mode = backendSelect.value;
            const count = inputCount.value;
            const minMag = inputMinMag.value;
            const seed = inputSeed.value;

            const fwUi = {
                overlay: fwOverlay,
                parseLbl: fwParseLbl,
                renderLbl: fwRenderLbl,
                statsLbl: fwStatsLbl,
                memoryLbl: fwMemoryLbl,
                memoryBar: fwMemoryBar,
                layerGroup: fwLayerGroup,
                color: '#e11d48'
            };

            const net10Ui = {
                overlay: net10Overlay,
                parseLbl: net10ParseLbl,
                renderLbl: net10RenderLbl,
                statsLbl: net10StatsLbl,
                memoryLbl: net10MemoryLbl,
                memoryBar: net10MemoryBar,
                layerGroup: net10LayerGroup,
                color: '#10b981'
            };

            let fwResult = null;
            let net10Result = null;

            if (mode === 'legacy') {
                showOverlay(net10Overlay, 'Omitido (Modo seleccionado: Solo Backend Legado .NET 4.8)', false);
                fwResult = await invokeBackend('legacy', count, minMag, seed, fwUi);
            } else if (mode === 'net10') {
                showOverlay(fwOverlay, 'Omitido (Modo seleccionado: Solo Backend Moderno .NET 10)', false);
                net10Result = await invokeBackend('net10', count, minMag, seed, net10Ui);
            } else {
                const results = await Promise.all([
                    invokeBackend('legacy', count, minMag, seed, fwUi),
                    invokeBackend('net10', count, minMag, seed, net10Ui)
                ]);
                fwResult = results[0];
                net10Result = results[1];
            }

            if (fwResult && net10Result) {
                equivalenceBanner.style.display = 'block';
                if (fwResult.ok && net10Result.ok) {
                    const sameCount = fwResult.data.returnedCount === net10Result.data.returnedCount;
                    const sameAvg = fwResult.data.averageMagnitude === net10Result.data.averageMagnitude;
                    const sameMax = fwResult.data.maxMagnitude === net10Result.data.maxMagnitude;
                    const equivalent = sameCount && sameAvg && sameMax;

                    equivalenceBanner.style.background = equivalent ? 'rgba(16, 185, 129, 0.15)' : 'rgba(225, 29, 72, 0.2)';
                    equivalenceBanner.style.borderColor = equivalent ? 'rgba(16, 185, 129, 0.4)' : 'rgba(225, 29, 72, 0.5)';
                    equivalenceBanner.innerHTML = equivalent
                        ? `<strong>✓ Equivalencia Funcional Verificada (Semilla ${seed}):</strong> Ambos backends procesaron exactamente <strong>${fwResult.data.returnedCount}</strong> sismos con magnitud promedio <strong>${fwResult.data.averageMagnitude}</strong> y máxima <strong>${fwResult.data.maxMagnitude}</strong> (HTTP 200 OK).`
                        : `<strong>⚠ Diferencia detectada:</strong> Revisa los parámetros de entrada.`;
                } else if (!fwResult.ok && !net10Result.ok && fwResult.status === net10Result.status) {
                    equivalenceBanner.style.background = 'rgba(245, 158, 11, 0.15)';
                    equivalenceBanner.style.borderColor = 'rgba(245, 158, 11, 0.4)';
                    equivalenceBanner.innerHTML = `<strong>✓ Equivalencia de Validación Verificada (HTTP ${fwResult.status}):</strong> Ambos backends rechazaron la entrada inválida con la misma regla de negocio (${fwResult.detail}).`;
                }
            }

            btnRun.disabled = false;
        });
    </script>
}
