@{
    ViewBag.Title = "Página en Angular";
    Layout = "~/Views/Shared/_LayoutProtected.cshtml";
}

<div class="row">
    <div class="col-md-12 text-center mt-4">
        <h2>@ViewBag.Title</h2>
        <p class="lead">Esta página servirá como contenedor para la aplicación en Angular.</p>
        
        <div class="alert alert-warning mt-4" role="alert">
            Cargando scripts y componentes de Angular...
        </div>
        
        <!-- Aquí iría el <app-root></app-root> o similar -->
        <div style="border: 2px dashed #b71c1c; padding: 50px; margin-top: 30px;">
            <h4>Contenedor Angular</h4>
            <p>El framework Angular se inicializará dentro de este espacio.</p>
        </div>
    </div>
</div>
