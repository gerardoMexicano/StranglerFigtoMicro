<configuration>
  <connectionStrings>
    <add name="ConexionDB" connectionString="Server=127.0.0.1,1433;Database=Laboratory;User Id=app_admin;Password=Adm1n_S3gur0!2026;" providerName="System.Data.SqlClient" />
    <add name="ConexionTaxesProto" connectionString="Server=127.0.0.1,1433;Database=taxes_proto;User Id=app_admin;Password=Adm1n_S3gur0!2026;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <!-- Secrets.config (ignorado por git) agrega oidc:ClientSecret; plantilla en Secrets.config.example -->
  <appSettings file="Secrets.config">
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
	<add key="RutaAppWebF" value="https://localhost:44346" />
	<!-- Incrementar el límite de 1000 llaves/archivos que tiene ASP.NET por defecto por seguridad -->
	<add key="aspnet:MaxHttpCollectionKeys" value="10000" />
	<!-- Login con Keycloak (OWIN, ver Startup.cs). Cliente legacy-mvc del realm laboratorio -->
	<add key="oidc:Authority" value="https://192.168.50.10/auth/realms/laboratorio" />
	<add key="oidc:ClientId" value="legacy-mvc" />
	<add key="oidc:RedirectUri" value="https://localhost:44333/signin-oidc" />
	<add key="oidc:PostLogoutRedirectUri" value="https://localhost:44333/" />
	<!-- Keycloak por https (certificado de mkcert: la CA debe estar instalada en esta PC) -->
	<add key="oidc:RequireHttpsMetadata" value="true" />
	<!-- Duración de la sesión local (cookie .AUTH.MVC), deslizante -->
	<add key="auth:SesionMinutos" value="60" />
	<!-- IPs desde las que se aceptan X-Forwarded-Proto/Host (el gateway). Vacío = sin proxy -->
	<add key="proxy:Confiables" value="" />
  </appSettings>
  <system.web>
	  <machineKey validation="HMACSHA256" decryption="AES" validationKey="BA3EEC07B099BABB899CDCADF2804E3D6EC357703D0672E15FEEACFD2A3E86CC" decryptionKey="0AA4ED411BEEA01709E3D11249F28FC1A1867AF6969A812EC60840B5299C0EA4" />
	  <!-- La autenticación la hace OWIN (Startup.cs). Con Forms activo, su módulo convertiría
	       el 401 en redirect a loginUrl y pelearía con el challenge de OpenID Connect. -->
	  <authentication mode="None" />
	  <compilation debug="true" targetFramework="4.8.1" />
	<!-- Incrementar el tamaño de la petición (100MB) y el tiempo de espera para el procesamiento síncrono lento -->
    <httpRuntime targetFramework="4.8.1" maxRequestLength="102400" executionTimeout="3600" />
	  <globalization
      fileEncoding="utf-8"
      requestEncoding="utf-8"
      responseEncoding="utf-8"
      culture="es-MX"
      uiCulture="es-MX" />
  </system.web>
  <runtime>
