<?xml version="1.0" encoding="utf-8"?>
<!--
  Copiar como Secrets.config (ignorado por git) en esta misma carpeta.
  Web.config lo incluye con <appSettings file="Secrets.config">; si no existe, se ignora.
-->
<appSettings>
  <!-- Keycloak: Clients > legacy-webforms > Credentials > Client secret -->
  <add key="oidc:ClientSecret" value="" />
</appSettings>
