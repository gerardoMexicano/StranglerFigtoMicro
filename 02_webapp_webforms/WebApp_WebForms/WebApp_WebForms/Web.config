<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  https://go.microsoft.com/fwlink/?LinkId=169433
  -->
<configuration>
  <!-- Secrets.config (ignorado por git) agrega oidc:ClientSecret; plantilla en Secrets.config.example -->

  <appSettings file="Secrets.config">
    <!-- URL de la aplicación MVC -->
    <add key="RutaAppMVC"
      value="http://192.168.50.10/taxes" />

    <!-- Keycloak -->
    <add key="oidc:Authority"
      value="http://192.168.50.10/auth/realms/laboratorio" />

    <add key="oidc:ClientId"
      value="legacy-webforms" />

    <!-- Debe coincidir con el callback registrado en Keycloak -->
    <add key="oidc:RedirectUri"
      value="http://192.168.50.10/legacy/signin-oidc" />

    <add key="oidc:PostLogoutRedirectUri"
      value="http://192.168.50.10/legacy/" />

    <!-- Solo para desarrollo HTTP -->
    <add key="oidc:RequireHttpsMetadata"
      value="false" />

    <add key="auth:SesionMinutos"
      value="60" />

    <!-- IP del gateway de confianza -->
    <add key="proxy:Confiables"
      value="192.168.50.10" />

    <!-- Conserva esta clave solo si tu código todavía la utiliza -->
    <add key="RutaAcceso"
      value="RUTA_REAL_DEL_ARCHIVO_DE_CREDENCIALES" />
  </appSettings>


  <connectionStrings>
	<add name="ConexionDB" connectionString="Server=127.0.0.1,1433;Database=Laboratory;User Id=app_admin;Password=Adm1n_S3gur0!2026;" providerName="System.Data.SqlClient" />
	<add name="WideWorldImporters" connectionString="Server=127.0.0.1,1433;Database=WideWorldImporters;User Id=app_admin;Password=Adm1n_S3gur0!2026;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
	<machineKey validation="HMACSHA256" decryption="AES" validationKey="BA3EEC07B099BABB899CDCADF2804E3D6EC357703D0672E15FEEACFD2A3E86CC" decryptionKey="0AA4ED411BEEA01709E3D11249F28FC1A1867AF6969A812EC60840B5299C0EA4" />
    <!-- La autenticación la hace OWIN (Startup.vb). Con Forms activo, su módulo convertiría
	       el 401 en redirect a loginUrl y pelearía con el challenge de OpenID Connect. -->
	  <authentication mode="None" />
	  <!-- Toda la app exige sesión: un anónimo recibe 401 y OWIN lo manda a Keycloak
	       (requiere UseStageMarker en Startup.vb). Excepciones en los <location> de abajo. -->
	  <authorization>
		  <deny users="?" />
	  </authorization>
	<compilation debug="true" strict="false" explicit="true" targetFramework="4.8.1" />
    <httpRuntime targetFramework="4.8.1" />
    <pages>
      <namespaces>
        <add namespace="System.Web.Optimization" />
      </namespaces>
      <controls>
        <add assembly="Microsoft.AspNet.Web.Optimization.WebForms" namespace="Microsoft.AspNet.Web.Optimization.WebForms" tagPrefix="webopt" />
      </controls>
    </pages>
	  <globalization
			fileEncoding="utf-8"
			requestEncoding="utf-8"
			responseEncoding="utf-8"
			culture="es-MX"
			uiCulture="es-MX" />
  </system.web>
  <!-- Rutas sin sesión: la portada (con su botón "Entrar"), el callback de Keycloak (lo atiende OWIN)
       y los archivos estáticos. Default y Default.aspx: FriendlyUrls la sirve con y sin extensión -->
  <location path="Default.aspx">
	<system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Default">
	<system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="signin-oidc">
	<system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Content">
	<system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Scripts">
	<system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="bundles">
	<system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="favicon.ico">
	<system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
