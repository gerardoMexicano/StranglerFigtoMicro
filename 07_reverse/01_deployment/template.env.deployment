# ==============================================================================
# Plantilla de variables del stack (nginx + gateway + keycloak)
# Copiar a .env.development / .env.testing / .env.production (ignorados por git)
# y usar:  docker compose --env-file .env.<ambiente> up -d --build
# ==============================================================================

# ── Ambiente ──────────────────────────────────────────────────────────────────
# development | testing | production
APP_ENV=development
# Prefijo de contenedores y volúmenes (cada ambiente con su propia BD de Keycloak)
COMPOSE_PROJECT_NAME=lab-development
# Development | Testing | Production
ASPNETCORE_ENVIRONMENT=Development
TZ=America/Mexico_City

# ── Dominio público ───────────────────────────────────────────────────────────
# Para cambiar de dominio basta con APP_DOMAIN (y APP_SCHEME si pasa a https).
# Es el host con el que el NAVEGADOR entra; Keycloak arma login/redirects/issuer con él.
# "localhost" solo sirve en esta misma PC; para probar desde otra PC de la red usar
# la IP de esta máquina (p. ej. 192.168.50.10) o un nombre que resuelva a ella.
APP_SCHEME=http
APP_DOMAIN=localhost
NGINX_HTTP_PORT=80
# https con el certificado de nginx/certs/ (lab.pem + lab-key.pem, ver README)
NGINX_HTTPS_PORT=443
# Si el puerto del esquema no es el estándar, agregarlo: ${APP_SCHEME}://${APP_DOMAIN}:8080
APP_PUBLIC_URL=${APP_SCHEME}://${APP_DOMAIN}

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7
# start-dev (development) | start (testing / production)
KC_COMMAND=start-dev
KC_LOG_LEVEL=info
# Keycloak se publica en ${APP_PUBLIC_URL}/auth
KC_HTTP_RELATIVE_PATH=/auth
KC_HOSTNAME=${APP_PUBLIC_URL}${KC_HTTP_RELATIVE_PATH}

# Admin del realm master (solo se crea en el primer arranque)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Realm y clientes importados desde keycloak/import/
KC_REALM=laboratorio
KC_FRONTEND_CLIENT_ID=frontend-spa
KC_API_CLIENT_ID=backend-api

# ── Base de datos de Keycloak ─────────────────────────────────────────────────
KC_DB_IMAGE=postgres:17-alpine
KC_DB_NAME=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=

# ── Destinos del gateway (Strangler Fig) ──────────────────────────────────────
LEGACY_BASE_URL=http://192.168.50.243:8081
TAXES_BASE_URL=http://192.168.50.243:8081
# Backend .NET 10 (05_backend) por la red "backend": el gateway le manda /api/*
BACKEND_API_BASE_URL=http://backend-api:8080
# App Angular nueva (06_frontend) por la red "backend": el gateway le manda /newapp/* y "/" redirige ahí
FRONTEND_NEWAPP_BASE_URL=http://frontend-newapp:8080

# ── Migración de usuarios del legacy (plugin + servicio legacy-auth) ──────────
# BD legacy (solo lectura, login app_lector). Requiere haber corrido
# sqlserver/db/03_usuarios_hash_expand.sql en esa instancia.
LEGACY_DB_CONNECTION=Server=192.168.50.243,1433;Database=Laboratory;User Id=app_lector;Password=;TrustServerCertificate=True
# BD WideWorldImporters para 05_backend (módulo Sales / LEgFrontNEWBACK)
WWI_DB_CONNECTION=Server=192.168.50.243,1433;Database=WideWorldImporters;User Id=app_lector;Password=;TrustServerCertificate=True
# Token compartido Keycloak -> legacy-auth
LEGACY_AUTH_API_TOKEN=
# Secreto del cliente legacy-cutover (comando "corte" al final de la ventana)
KC_CUTOVER_CLIENT_SECRET=

# ── Apps legacy que inician sesión con Keycloak (OWIN) ────────────────────────
# URLs con las que el NAVEGADOR entra a cada app, sin "/" final. Keycloak solo acepta
# volver a <url>/signin-oidc. Se importan solo en el primer arranque; en un realm
# existente se cambian en la consola (Clients > legacy-* > Settings).
#   *_URL      entrada por el gateway (MVC en /taxes, WebForms en /legacy)
#   *_DEV_URL  Visual Studio / IIS Express; en testing/production = la misma que *_URL
LEGACY_MVC_URL=${APP_PUBLIC_URL}/taxes
LEGACY_MVC_DEV_URL=https://localhost:44333
LEGACY_WEBFORMS_URL=${APP_PUBLIC_URL}/legacy
LEGACY_WEBFORMS_DEV_URL=https://localhost:44346
# Secretos de los clientes confidenciales legacy-mvc / legacy-webforms
# (van también en la configuración de cada app)
LEGACY_MVC_CLIENT_SECRET=
LEGACY_WEBFORMS_CLIENT_SECRET=

# ── Correo (verificación de email, restablecer contraseña) ────────────────────
# Se importa al realm solo en el primer arranque; después se cambia en la consola.
# development: Mailpit (COMPOSE_PROFILES=mail). testing/production: SMTP real.
COMPOSE_PROFILES=
MAILPIT_UI_PORT=8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@laboratorio.local
SMTP_AUTH=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=false
