{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "legacy-route": {
        "ClusterId": "legacy-cluster",
        "Match": {
          "Path": "/legacy/{**catch-all}"
        }
      },
      "taxes-route": {
        "ClusterId": "taxes-cluster",
        "Match": {
          "Path": "/taxes/{**catch-all}"
        }
      },
      "backend-api-route": {
        "ClusterId": "backend-api-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "frontend-newapp-route": {
        "ClusterId": "frontend-newapp-cluster",
        "Match": {
          "Path": "/newapp/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "legacy-cluster": {
        "Destinations": {
          "legacy": {
            "Address": "http://192.168.50.243:8081"
          }
        }
      },
      "taxes-cluster": {
        "Destinations": {
          "taxes": {
            "Address": "http://192.168.50.243:8081"
          }
        }
      },
      "backend-api-cluster": {
        "Destinations": {
          "backend-api": {
            "Address": "http://backend-api:8080"
          }
        }
      },
      "frontend-newapp-cluster": {
        "Destinations": {
          "frontend-newapp": {
            "Address": "http://frontend-newapp:8080"
          }
        }
      }
    }
  }
}
