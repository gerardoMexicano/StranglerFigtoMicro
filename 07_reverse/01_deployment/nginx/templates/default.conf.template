# Plantilla procesada por el entrypoint de nginx (envsubst) al arrancar.
# Solo se sustituyen las variables declaradas en el servicio nginx del compose
# (APP_DOMAIN, KC_HTTP_RELATIVE_PATH); las de nginx ($host, ...) quedan intactas.
#
# 80 y 443 sirven lo mismo (sitio.inc). Durante la migración a https el 80 sigue atendiendo:
# las apps que aún regresan por http no pierden el login. Al terminar, el 80 pasa a redirigir.

server {
    listen 80 default_server;
    server_name ${APP_DOMAIN};

    include /etc/nginx/conf.d/sitio.inc;
}

# Certificado de nginx/certs/ (mkcert, ignorado por git). Sin lab.pem / lab-key.pem nginx no arranca.
server {
    listen 443 ssl default_server;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/nginx/certs/lab.pem;
    ssl_certificate_key /etc/nginx/certs/lab-key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    include /etc/nginx/conf.d/sitio.inc;
}
