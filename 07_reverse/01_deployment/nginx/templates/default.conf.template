# Plantilla procesada por el entrypoint de nginx (envsubst) al arrancar.
# Solo se sustituyen las variables declaradas en el servicio nginx del compose
# (APP_SCHEME, APP_DOMAIN, APP_PUBLIC_URL, KC_HTTP_RELATIVE_PATH); las de nginx ($host, ...) quedan intactas.
#
# El 80 depende de APP_SCHEME (puerto80-<esquema>.inc):
#   http   sirve el sitio (sitio.inc), igual que el 443
#   https  redirige con 301 a APP_PUBLIC_URL

server {
    listen 80 default_server;
    server_name ${APP_DOMAIN};

    include /etc/nginx/conf.d/puerto80-${APP_SCHEME}.inc;
}

# Certificado de nginx/certs/ (mkcert, ignorado por git). Sin lab.pem / lab-key.pem nginx no arranca.
server {
    listen 443 ssl default_server;
    server_name ${APP_DOMAIN};

    ssl_certificate     /etc/nginx/certs/lab.pem;
    ssl_certificate_key /etc/nginx/certs/lab-key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    include /etc/nginx/conf.d/sitio.inc;
}
